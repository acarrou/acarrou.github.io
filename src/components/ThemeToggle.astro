---
// Light/dark toggle. The initial theme is applied by the blocking inline
// script in BaseLayout <head> so there is no flash; this component only
// mirrors that state into the checkbox and handles user changes.
---

<script>
  const DARK = "black";
  const LIGHT = "lofi";
  const KEY = "theme";

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLInputElement>("input[data-theme-toggle]");
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  const apply = (theme: string) => {
    root.setAttribute("data-theme", theme);
    if (toggle) toggle.checked = theme === LIGHT;
  };

  // Mirror whatever the head script already applied.
  apply(root.getAttribute("data-theme") === LIGHT ? LIGHT : DARK);

  toggle?.addEventListener("change", () => {
    const theme = toggle.checked ? LIGHT : DARK;
    apply(theme);
    try {
      localStorage.setItem(KEY, theme);
    } catch {}
  });

  // Follow OS changes only while the visitor has not picked a theme.
  media.addEventListener("change", (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (stored === DARK || stored === LIGHT) return;
    apply(e.matches ? DARK : LIGHT);
  });
</script>

<div
  class="flex items-center absolute top-4 right-4 md:top-6 md:right-6 lg:top-8 lg:right-8 xl:top-10 xl:right-10 z-10"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <input
    type="checkbox"
    data-theme-toggle
    aria-label="Switch between dark and light theme"
    class="toggle toggle-sm mx-1 bg-secondary"
  />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path
      d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
    ></path>
  </svg>
</div>
